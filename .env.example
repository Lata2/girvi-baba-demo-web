# Backend API base URL. Leave empty to run the site on built-in mock data.
VITE_API_URL=""

# Copy to `.env` (or `.env.production`) and fill in real, verified details.
# Leave a value empty to hide it — Call/WhatsApp buttons then open the enquiry form instead.

# Shown on Call buttons and used for tel: links
VITE_CONTACT_PHONE="+91 98765 43210"

# International format, digits only, no "+" (used for https://wa.me/<number>)
VITE_WHATSAPP_NUMBER="919876543210"

# Optional pre-filled WhatsApp message
VITE_WHATSAPP_MESSAGE="Hello Girvi Baba, I would like to know how much loan I can get against my item."

VITE_CONTACT_EMAIL=""
VITE_CONTACT_ADDRESS=""
